{
  "name": "readyroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node backend/server/index.js",
    "build": "next build frontend",
    "start": "node backend/server/index.js --production",
    "evaluate": "node scripts/evaluate.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-env.js",
    "verify:connections": "node scripts/check-connections.js",
    "verify:api": "node scripts/verify-api.js",
    "verify:batch": "node scripts/verify-batch.js",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prettier": "^3.9.8",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.0"
  }
}
